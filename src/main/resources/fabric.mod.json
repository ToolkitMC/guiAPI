{
  "schemaVersion": 1,
  "id": "guiapi",
  "version": "${version}",
  "name": "GUI API",
  "description": "Datapack-driven chest GUI system for Minecraft 26.2.",
  "authors": [
    {
      "name": "ToolkitMC",
      "contact": {
        "sources": "https://github.com/ToolkitMC"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/gui-api",
    "issues": "https://github.com/ToolkitMC/guiAPI/issues",
    "sources": "https://github.com/ToolkitMC/guiAPI"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.toolkitmc.guiapi.GuiApiMod"
    ],
    "client": [
      "dev.toolkitmc.guiapi.client.GuiApiClient"
    ],
    "modmenu": [
      "dev.toolkitmc.guiapi.modmenu.GuiApiModMenuEntry"
    ]
  },
  "mixins": [
    "guiapi.mixins.json",
    {
      "config": "guiapi.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  }
}
