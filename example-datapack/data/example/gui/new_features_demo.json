      "actions": [
        { "type": "add_effect", "value": "minecraft:speed:15:1:false" },
        { "type": "sound", "value": "minecraft:entity.generic.drink" },
        { "type": "action_bar", "value": "§bHız II Efekti Verildi!" }
      ],
      "click_type": "left"
    },
    {
      "slot": 20,
      "item": "minecraft:brewing_stand",
      "name": "§d8. İksir Efekt Yönetimi",
      "lore": [
        "§7Sol Tık: §bHız Efekti Al (15 sn)",
        "§7Sağ Tık: §cEfektleri Temizle (Süt İç)"
      ],
      "actions": [
        { "type": "clear_effects" },
        { "type": "sound", "value": "minecraft:entity.cow.milk" },
        { "type": "action_bar", "value": "§cTüm efektler temizlendi!" }
      ],
      "click_type": "right"
    },
    {
      "slot": 22,
      "item": "minecraft:experience_bottle",
      "name": "§a7. Seviye Kontrolü §7(Level >= 30)",
      "lore": [
        "§7Yalnızca 30 veya üzeri XP Seviyesine",
        "§7sahip oyuncular bu butona tıklayabilir!"
      ],
      "condition": { "type": "level_gt", "value": "29" },
      "actions": [
        { "type": "sound", "value": "minecraft:entity.player.levelup" },
        { "type": "action_bar", "value": "§aTebrikler! Seviyeniz yeterli." }
      ]
    },
    {
      "slot": 22,
      "item": "minecraft:glass_bottle",
      "name": "§c7. Seviye Kontrolü §7(Kilitli)",
      "lore": [
        "§cSeviyeniz 30'dan düşük!",
        "§7Bu özellik kilitli."
      ],
      "condition": { "type": "level_lt", "value": "30" },
      "actions": [
        { "type": "sound", "value": "minecraft:entity.enderman.teleport:0.5:0.5" },
        { "type": "action_bar", "value": "§cEn az 30 seviye olmalısınız!" }
      ]
    },
    {
      "slot": 24,
      "item": "minecraft:book",
      "name": "§b3. Çoklu Custom Model Data",
      "lore": [
        "§7Gelişmiş 1.21.4+ floats/flags/strings/colors"
      ],
      "custom_model_data": {
        "floats": [42.5],
        "flags": [true, false],
        "strings": ["demo_tag"],
        "colors": [16711680]
      }
    },
    {
      "slot": 26,
      "item": "minecraft:stick",
      "name": "§bStick. Özel Eşya Modeli",
      "lore": [
        "§7item_model componentini stick üzerine uygular."
      ],
      "item_model": "my_pack:item/custom_sword"
    },
    {
      "slot": 31,
      "item": "minecraft:barrier",
      "name": "§cKapat",
      "actions": [
        { "type": "sound", "value": "minecraft:ui.button.click" },
        { "type": "close" }
      ]
    }
