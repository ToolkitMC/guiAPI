{
  "title": "§dMaster GUI Demo §8— {player}",
  "rows": 4,
  "tick_rate": 20,
  "close_on_move": true,
  "filler": {
    "item": "minecraft:gray_stained_glass_pane",
    "name": " ",
    "glint": false,
    "hide_tooltip": true
  },
  "on_open": [
    { "type": "set_var", "var": "counter", "value": "1" }
  ],
  "buttons": [
    {
      "slot": 4,
      "item": "minecraft:player_head",
      "name": "§d★ Master GUI API Demo ★",
      "lore": [
        "§7Current value: §f{var:counter}",
        "§7Current Score (Coins): §e{score:coins}",
        "§7XP Level: §a{player}'s level",
        "§7Auto-refreshing every 1 second (tick_rate: 20)",
        "§7Closes automatically if you walk away (close_on_move: true)",
        "§7Empty slots are automatically filled (filler object)"
      ]
    },
    {
      "slot": 10,
      "item": "minecraft:lime_concrete",
      "name": "§a1. Dinamik Miktar & Gecikmeli Aksiyonlar",
      "amount": "{var:counter}",
      "lore": [
        "§7Sayaç değerine göre eşyanın miktarı dinamik olarak güncellenir!",
        "§7Sonraki miktar: §f{var:counter}",
        "§7Tıkladığında 1 artar, 20 tick (1sn) bekler, sonra ses çalar!"
      ],
      "actions": [
        { "type": "add_var", "var": "counter", "value": "1" },
        { "type": "action_bar", "value": "§aSayaç güncellendi: {var:counter}! Ses 1 saniye sonra çalacak..." },
        { "type": "refresh" },
        { "type": "sound", "value": "minecraft:entity.experience_orb.pickup:0.5:1.2", "delay": 20 }
      ]
    },
    {
      "slot": 12,
      "item": "minecraft:diamond_sword",
      "name": "§b2. Eşya Marketi §a(Demir Al)",
      "lore": [
        "§7Maliyet: §e5 Altın Parçası",
        "§7Satın almak için envanterinizde altın olmalıdır."
      ],
      "condition": { "type": "has_item", "value": "minecraft:gold_nugget:5" },
      "actions": [
        { "type": "take_item", "value": "minecraft:gold_nugget:5" },
        { "type": "run_command", "value": "give @s minecraft:iron_ingot", "run_with": "console" },
        { "type": "sound", "value": "minecraft:entity.villager.yes" },
        { "type": "action_bar", "value": "§aSatın alım başarılı!" },
        { "type": "refresh" }
      ]
    },
    {
      "slot": 12,
      "item": "minecraft:barrier",
      "name": "§c2. Eşya Marketi §7(Kilitli)",
      "lore": [
        "§7Maliyet: §e5 Altın Parçası",
        "§cEnvanterinizde yeterli Altın Parçası yok!"
      ],
      "condition": { "type": "not_item", "value": "minecraft:gold_nugget:5" },
      "actions": [
        { "type": "sound", "value": "minecraft:entity.villager.no" },
        { "type": "action_bar", "value": "§cYetersiz bakiye!" }
      ]
    },
    {
      "slot": 14,
      "item": "minecraft:gold_block",
      "name": "§e5. Scoreboard & ActionBar Desteği",
      "lore": [
        "§7Doğrudan scoreboard skorunuzu değiştirir!",
        "§7Sol Tık: §a+10 Coin",
        "§7Sağ Tık: §c-10 Coin",
        "§7Mevcut Coin: §e{score:coins}"
      ],
      "actions": [
        { "type": "add_score", "value": "coins:10" },
        { "type": "sound", "value": "minecraft:entity.experience_orb.pickup" },
        { "type": "action_bar", "value": "§aHesabınıza +10 Coin eklendi!" },
        { "type": "refresh" }
      ],
      "click_type": "left"
    },
    {
      "slot": 14,
      "item": "minecraft:gold_block",
      "name": "§e5. Scoreboard & ActionBar Desteği",
      "lore": [
        "§7Doğrudan scoreboard skorunuzu değiştirir!",
        "§7Sol Tık: §a+10 Coin",
        "§7Sağ Tık: §c-10 Coin",
        "§7Mevcut Coin: §e{score:coins}"
      ],
      "actions": [
        { "type": "sub_score", "value": "coins:10" },
        { "type": "sound", "value": "minecraft:block.anvil.land:0.2:1.5" },
        { "type": "action_bar", "value": "§cHesabınızdan -10 Coin eksildi!" },
        { "type": "refresh" }
      ],
      "click_type": "right"
    },
    {
      "slot": 16,
      "item": "minecraft:netherite_sword",
      "name": "§c6. Sadeleştirilmiş Nitelikler",
      "lore": [
        "§7Kılıcın altındaki hasar değerleri vb. tooltip kalabalığı temizlendi!"
